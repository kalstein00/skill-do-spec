{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "do-spec 0.2 project sidecar (issue-closed default; live contracts still gated)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repo", "state_dir", "dagu", "tracker", "agent", "parent", "spec"],
  "properties": {
    "schema_version": {"const": 1},
    "completion": {"enum": ["issue-closed", "external-checkpoint"], "default": "issue-closed"},
    "draft": {"type": "boolean"},
    "repo": {"type": "string"},
    "state_dir": {"type": "string"},
    "dagu": {"type": "string"},
    "spec": {"type": "string"},
    "parent": {"type": "string"},
    "tracker": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["local", "github", "forgejo"]}, "state_file": {"type": "string"}}},
    "agent": {
      "type": "object", "additionalProperties": false, "required": ["kind", "argv", "timeout"],
      "properties": {"kind": {"enum": ["fake", "cline"]}, "argv": {"type": "array", "items": {"type": "string"}}, "timeout": {"type": "number", "exclusiveMinimum": 0}, "contract": {"const": "cline-3.0.61-local"}, "auto_approve": {"type": "boolean", "default": false}}
    },
    "checks": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["name", "argv", "timeout"],
        "properties": {"name": {"type": "string"}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "timeout": {"type": "number", "exclusiveMinimum": 0}}}
    },
    "tickets": {
      "type": "array", "maxItems": 100,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": {"id": {"type": "string", "pattern": "^[0-9]+$"}, "path": {"type": "string"}}}
    },
    "allowed_paths": {"type": "array", "items": {"type": "string"}},
    "protected_paths": {"type": "array", "items": {"type": "string"}},
    "context": {"type": "array", "items": {"type": "string"}},
    "max_prompt_bytes": {"type": "integer", "minimum": 1},
    "reporting": {"const": "local-only"},
    "artifact_contract": {
      "type": "object", "additionalProperties": false, "required": ["parent", "blocked_by", "acceptance"],
      "properties": {"parent": {"type": "string"}, "blocked_by": {"type": "string"}, "acceptance": {"type": "string"}}
    }
  }
}
